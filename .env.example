# Copy to .env and adjust. All values are optional - sensible defaults apply.

# Machine role: "hub" (runs bots + auto-fix + nightly jobs) or "agent" (status only).
# Can also be set in machine-role.json. Defaults to hub.
MACHINE_ROLE=hub

# Path to the Caddyfile the monitor edits when provisioning app reverse proxies.
# Defaults to /opt/homebrew/etc/Caddyfile (Homebrew Caddy on macOS).
CADDYFILE=/opt/homebrew/etc/Caddyfile

# Bind address for the control API (default 127.0.0.1). Set to a tailnet/LAN IP
# ONLY for trusted multi-machine peer sync.
# API_BIND=127.0.0.1

# Optional shared-secret for off-box control. The API fails CLOSED for any
# non-localhost caller: every mutating request (POST/PUT/DELETE) and every
# sensitive read (logs) is DENIED unless it presents  x-local-apps-token: <this value>.
# Localhost is always fully trusted. Set this only to grant a trusted LAN/tailnet
# machine control; leave it unset and off-box callers can still VIEW status but
# cannot act. See lib/auth-gate.js for the exact policy.
# LOCAL_APPS_TOKEN=
