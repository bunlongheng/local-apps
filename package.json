{
  "name": "local-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Local app process monitor with web dashboard",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "build": "echo 'no build needed - static UI served on :9875'",
    "start": "node --env-file-if-exists=.env server.js",
    "server": "node --env-file-if-exists=.env --watch server.js",
    "icons": "node scripts/generate-favicons.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test 'tests/unit/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=91 --test-coverage-branches=75 --test-coverage-functions=82 --test-coverage-include='{server.js,db.js,launchctl-cmds.js,lib/**,routes/**,scripts/consistency.js,scripts/coverage-floor.js,public/app.js}' 'tests/unit/**/*.test.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.js'",
    "test:all": "node --test 'tests/unit/**/*.test.js' 'tests/e2e/**/*.test.js'",
    "test:coverage:dashboard": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=/tmp/local-apps-lcov.info --test-coverage-include=public/app.js 'tests/unit/dashboard.test.js' && node scripts/coverage-floor.js /tmp/local-apps-lcov.info public/app.js 80 60"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
