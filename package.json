{
  "name": "local-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Local app process monitor with web dashboard",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "build": "echo 'no build needed - static UI served on :9875'",
    "start": "node --env-file-if-exists=.env server.js",
    "server": "node --env-file-if-exists=.env --watch server.js",
    "icons": "node scripts/generate-favicons.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test --test-timeout=30000 'tests/unit/**/*.test.js'",
    "test:unit": "node --test --test-timeout=30000 'tests/unit/**/*.test.js'",
    "test:coverage": "node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=92 --test-coverage-branches=76 --test-coverage-functions=83 --test-coverage-include=\"$npm_package_config_coverageInclude\" 'tests/unit/**/*.test.js'",
    "test:e2e": "node --test --test-timeout=30000 'tests/e2e/**/*.test.js'",
    "test:all": "node --test --test-timeout=30000 'tests/unit/**/*.test.js' 'tests/e2e/**/*.test.js'",
    "test:coverage:dashboard": "node scripts/coverage-floor.js --run public/app.js 90 65 tests/unit/dashboard.test.js",
    "test:coverage:files": "node scripts/coverage-floor.js --all 80 50 \"$npm_package_config_coverageInclude\" 'tests/unit/**/*.test.js'"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.9"
  },
  "config": {
    "coverageInclude": "{server.js,db.js,launchctl-cmds.js,lib/**,routes/**,scripts/consistency.js,scripts/coverage-floor.js,public/app.js,public/sw.js}"
  }
}
