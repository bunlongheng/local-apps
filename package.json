{
  "name": "local-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Local app process monitor with web dashboard",
  "scripts": {
    "dev": "next dev -p 9876 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 9876 --hostname 0.0.0.0",
    "server": "node --watch server.js",
    "screenshots": "node scripts/screenshot-bot.js",
    "icons": "node scripts/generate-favicons.js",
    "lint": "eslint .",
    "test": "node --test tests/unit/ tests/e2e/",
    "test:unit": "node --test tests/unit/",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/",
    "test:e2e": "node --test tests/e2e/"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "gif-encoder-2": "^1.0.5",
    "marked": "^18.0.2",
    "next": "^16.2.6",
    "png-js": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "playwright": "^1.58.2",
    "typescript": "^5"
  }
}
