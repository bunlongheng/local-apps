{
  "name": "local-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Local app process monitor with web dashboard",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "build": "echo 'no build needed - static UI served on :9875'",
    "start": "node --env-file-if-exists=.env server.js",
    "server": "node --env-file-if-exists=.env --watch server.js",
    "icons": "node scripts/generate-favicons.js",
    "lint": "eslint .",
    "test": "node --test 'tests/unit/**/*.test.js' 'tests/e2e/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=52 --test-coverage-branches=68 --test-coverage-functions=60 'tests/unit/**/*.test.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.js'"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
